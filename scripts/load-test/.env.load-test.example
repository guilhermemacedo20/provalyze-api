# URL pública da API com prefixo /api
LOAD_TEST_BASE_URL=

# IDs da turma e da prova
LOAD_TEST_CLASS_ID=
LOAD_TEST_EXAM_ID=

# Arquivo gerado com email + senha de cada aluno
LOAD_TEST_STUDENTS_FILE=./scripts/load-test/students.json

# Quantos fluxos simultâneos (máximo = linhas no students.json)
LOAD_TEST_CONCURRENCY=100

# full | open | login
LOAD_TEST_SCENARIO=full

# Saída das métricas
LOAD_TEST_REPORT=./scripts/load-test/reports/last-report.json

# Opcional: pausa entre abrir e entregar a prova (ms)
LOAD_TEST_THINK_MS=0

# Eventos durante a prova: aleatórios por aluno após abrir a prova
LOAD_TEST_EVENTS=true
LOAD_TEST_EVENTS_MIN=4
LOAD_TEST_EVENTS_MAX=10
